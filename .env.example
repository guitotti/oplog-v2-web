# URL base da API do back-end OPLOG
VITE_API_URL=http://localhost:8080/api

# "true" usa o mock de autenticação e qualquer outro valor usa a API real do back-end
VITE_USE_MOCK_AUTH=true

# "true" responde as chamadas GET da API a partir do bando de dados mockado em src/mocks/db.json
VITE_USE_MOCK_API=true
